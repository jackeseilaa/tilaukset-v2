rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /sailings/{docId} {
      allow read, write: if request.auth != null
        && request.auth.token.email == "jacke.seilaa@gmail.com";
    }
    match /customers/{docId} {
      allow read, write: if request.auth != null
        && request.auth.token.email == "jacke.seilaa@gmail.com";
    }
    match /companies/{docId} {
      allow read, write: if request.auth != null
        && request.auth.token.email == "jacke.seilaa@gmail.com";
    }
    match /invoices/{docId} {
      allow read, write: if request.auth != null
        && request.auth.token.email == "jacke.seilaa@gmail.com";
    }
    match /tutkinnot/{docId} {
      allow read, write: if request.auth != null
        && request.auth.token.email == "jacke.seilaa@gmail.com";
    }
    match /muutTuotteet/{docId} {
      allow read, write: if request.auth != null
        && request.auth.token.email == "jacke.seilaa@gmail.com";
    }
    match /kyselyt/{docId} {
      allow read, write: if request.auth != null
        && request.auth.token.email == "jacke.seilaa@gmail.com";
    }
    match /blockedDays/{docId} {
      allow read, write: if request.auth != null
        && request.auth.token.email == "jacke.seilaa@gmail.com";
    }
    match /meta/{docId} {
      allow read, write: if request.auth != null
        && request.auth.token.email == "jacke.seilaa@gmail.com";
    }
  }
}
